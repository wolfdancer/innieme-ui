# Use Node.js LTS as base image
FROM node:24-bookworm-slim AS development

# Build from the repo root so the workspace lockfile is used:
#   docker build -f client/Dockerfile.debug .

# Set working directory
WORKDIR /app

# Copy package files (root lockfile + every workspace manifest)
COPY package.json package-lock.json ./
COPY client/package.json client/
COPY server/package.json server/
COPY e2e/package.json e2e/

# Install client dependencies exactly as locked
RUN npm ci -w client

# Copy source code
COPY client/ client/
WORKDIR /app/client

# Expose Vite dev server port (3000)
EXPOSE 3000

# Start development server with hot reloading, without auto-opening the browser
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000", "--no-open"]